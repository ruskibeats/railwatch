[Unit]
Description=Rail board poll (Hemel Hempstead <-> London Euston)
Documentation=https://github.com/ruskibeats/railwatch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs the root-owned copy at /opt/uclh/railwatch as root, never the
# agent-writable checkout. Root is needed for the SSH hop to caddy and to read
# /etc/uclh-rail/config.json (root 600). install.sh puts the copy in place.
User=root
Group=root
EnvironmentFile=/etc/uclh-rail/ldbws.env
ExecStart=/usr/bin/node /opt/uclh/railwatch/rail/run.mjs
